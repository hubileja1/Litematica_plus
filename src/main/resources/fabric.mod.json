{
  "schemaVersion": 1,
  "id": "litematica_plus",
  "version": "${version}",
  "name": "Litematica+",
  "description": "Litematica extension: shows the expected contents of containers from your schematic and lets you replace blocks in loaded placements.",
  "icon": "assets/litematica_plus/icon.png",
  "authors": ["HubiL"],
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["pl.litematicaplus.LitematicaPlusClient"]
  },
  "mixins": [
    { "config": "litematica_plus.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*",
    "malilib": "*",
    "litematica": "*"
  }
}
